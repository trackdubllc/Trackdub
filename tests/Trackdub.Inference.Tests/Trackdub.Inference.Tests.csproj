<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FsCheck.Xunit" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.Managed" Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Trackdub.Application\Trackdub.Application.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Inference\Trackdub.Inference.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Inference.Onnx\Trackdub.Inference.Onnx.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Infrastructure\Trackdub.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Domain\Trackdub.Domain.csproj" />
    <ProjectReference Include="..\..\src\Trackdub.Composition\Trackdub.Composition.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <ProjectReference Update="..\..\src\Trackdub.Inference.Onnx\Trackdub.Inference.Onnx.csproj"
                      SetTargetFramework="TargetFramework=net10.0-windows10.0.19041.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="DeviceEnumeratorClassificationPropertyTests.cs" />
    <Compile Remove="WindowsMlProviderRegistrationPolicyTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Linux'))">
    <Compile Remove="LinuxDeviceEnumeratorTests.cs" />
    <Compile Remove="LinuxExecutionProviderBootstrapperTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('OSX'))">
    <Compile Remove="MacDeviceEnumeratorTests.cs" />
    <Compile Remove="MacExecutionProviderBootstrapperTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Trackdub.TestDoubles\FakeDeviceEnumerator.cs" Link="TestDoubles\FakeDeviceEnumerator.cs" />
    <Compile Include="..\Trackdub.TestDoubles\RequiresBundledModelFactAttribute.cs" Link="TestDoubles\RequiresBundledModelFactAttribute.cs" />
  </ItemGroup>

  <!--
    Align root onnxruntime.dll with the managed-package pair, mirroring the desktop app's
    AlignOnnxRuntimeNativeForGenAi step. Composition force-copies Windows ML's older ORT to the
    output root; the managed ORT/GenAI pair in this graph is 1.30, and GenAiNativeCompatibility
    rejects the mismatch before any GenAI model can load, so real-model GenAI tests (Phi, Qwen,
    Whisper GenAI) cannot run on the Windows TFM without this. Prefer runtimes/<rid>/native as
    the canonical app-base copy; skipped for the Dnnl flavor, where Trackdub.OnnxRuntime.Dnnl.Native
    owns libonnxruntime.*.
  -->
  <Target Name="AlignOnnxRuntimeNativeForGenAi"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0' And '$(TrackdubOrtRuntimeFlavor)' != 'Dnnl'">
    <PropertyGroup>
      <_GenAiNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_GenAiNativeRid>
      <_GenAiNativeRid Condition="'$(RuntimeIdentifier)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">win-arm64</_GenAiNativeRid>
      <_GenAiNativeRid Condition="'$(RuntimeIdentifier)' == '' And '$(_GenAiNativeRid)' == ''">win-x64</_GenAiNativeRid>
      <_GenAiNativeDir>$(TargetDir)runtimes\$(_GenAiNativeRid)\native\</_GenAiNativeDir>
    </PropertyGroup>
    <Copy SourceFiles="$(_GenAiNativeDir)onnxruntime.dll"
          DestinationFiles="$(TargetDir)onnxruntime.dll"
          Condition="'$(_GenAiNativeRid)' != '' And Exists('$(_GenAiNativeDir)onnxruntime.dll')"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="false" />
  </Target>

</Project>
