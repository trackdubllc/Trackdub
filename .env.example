# Trackdub API Configuration Example
# Copy this file to .env and customize for your environment

# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Logging
LOGGING_LEVEL=Information
LOG_OUTPUT_PATH=/app/logs

# Models & Caching
MODELS_CACHE_DIR=/data/models
MODEL_DOWNLOAD_TIMEOUT_SECONDS=300
AUTO_DOWNLOAD_MODELS=true

# Performance Tuning
DOTNET_TieredCompilation=1
DOTNET_TieredCompilationQuickJit=1

# Database Configuration (SQLite)
DATABASE_PATH=/data/trackdub.db

# Optional: API Authentication (future use)
# API_KEY=your-secret-key-here
# JWT_ISSUER=https://your-auth-server
# JWT_AUDIENCE=trackdub-api

# Optional: Rate Limiting (future use)
# RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Optional: ONNX Runtime Provider (cpu, cuda, tensorrt, etc.)
# ONNX_PROVIDER=cpu
