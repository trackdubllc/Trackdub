/ltm/store/
/ltm/runtime/
/ltm/reports/
/ltm/snapshots/
!ltm/reports/.gitkeep
!ltm/snapshots/.gitkeep

# --- MagicPaths prototype (local only) ---
MagicPaths/
/MagicPaths

