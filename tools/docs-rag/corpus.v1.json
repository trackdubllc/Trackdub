        ["trt-rtx-best-practices", "https://docs.nvidia.com/deeplearning/tensorrt-rtx/latest/performance/best-practices.html"],
        ["trt-rtx-troubleshooting", "https://docs.nvidia.com/deeplearning/tensorrt-rtx/latest/reference/troubleshooting.html"],
