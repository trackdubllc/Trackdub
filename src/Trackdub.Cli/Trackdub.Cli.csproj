<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFrameworks>
    <TargetFramework Condition="'$(TargetFrameworks)' != ''" />
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>trackdub</ToolCommandName>
    <PackageId>Trackdub.Cli</PackageId>
    <Authors>Trackdub</Authors>
    <Description>Trackdub command-line interface for the local-first AI dubbing pipeline.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/trackdubllc/Trackdub</RepositoryUrl>
    <PackageProjectUrl>https://github.com/trackdubllc/Trackdub</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <WindowsPackageType>None</WindowsPackageType>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <!-- Headless unpackaged CLI: Composition/Sdk own WinML bootstrap; skip entry-exe auto-init. -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trackdub.Sdk.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trackdub.Sdk\Trackdub.Sdk.csproj">
      <SetTargetFramework>TargetFramework=$(TargetFramework)</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

</Project>
