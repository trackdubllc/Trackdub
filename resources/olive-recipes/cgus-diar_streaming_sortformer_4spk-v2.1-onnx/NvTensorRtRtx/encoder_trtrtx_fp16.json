{
    "input_model": {
        "type": "OnnxModel",
        "model_path": "${MODEL_ROOT}/onnx/model.onnx"
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "gpu",
                    "execution_providers": [
                        [
                            "NvTensorRTRTXExecutionProvider",
                            "${TRT_RTX_EP_PATH}"
                        ]
                    ]
                }
            ]
        }
    },
    "data_configs": [
        {
            "name": "sortformer_steady_state",
            "type": "DummyDataContainer",
            "load_dataset_config": {
                "params": {
                    "input_names": [
                        "chunk",
                        "chunk_lengths",
                        "spkcache",
                        "spkcache_lengths",
                        "fifo",
                        "fifo_lengths"
                    ],
                    "input_shapes": [
                        [
                            1,
                            3040,
                            128
                        ],
                        [
                            1
                        ],
                        [
                            1,
                            188,
                            512
                        ],
                        [
                            1
                        ],
                        [
                            1,
                            40,
                            512
                        ],
                        [
                            1
                        ]
                    ],
                    "input_types": [
                        "float32",
                        "int64",
                        "float32",
                        "int64",
                        "float32",
                        "int64"
                    ]
                }
            }
        }
    ],
    "passes": {
        "fp16": {
            "type": "OnnxFloatToFloat16",
            "save_as_external_data": true,
            "keep_io_types": true
        },
        "session_params": {
            "type": "OrtSessionParamsTuning",
            "io_bind": true,
            "providers_list": "NvTensorRTRTXExecutionProvider",
            "data_config": "sortformer_steady_state"
        }
    },
    "evaluators": {
        "latency_evaluator": {
            "metrics": [
                {
                    "name": "latency",
                    "type": "latency",
                    "sub_types": [
                        {
                            "name": "avg",
                            "priority": 1,
                            "higher_is_better": false
                        },
                        {
                            "name": "max"
                        },
                        {
                            "name": "min"
                        }
                    ],
                    "data_config": "sortformer_steady_state"
                }
            ]
        }
    },
    "target": "local_system",
    "evaluator": "latency_evaluator",
    "cache_dir": "cache",
    "output_dir": "build/sortformer-4spk-onnx_encoder_trtrtx_fp16",
    "log_severity_level": 1
}
