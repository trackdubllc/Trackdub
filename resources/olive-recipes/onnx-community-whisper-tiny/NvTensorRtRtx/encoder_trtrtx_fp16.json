{
    "input_model": {
        "type": "OnnxModel",
        "model_path": "${MODEL_ROOT}/onnx/encoder_model.onnx"
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "gpu",
                    "execution_providers": [
                        [
                            "NvTensorRTRTXExecutionProvider",
                            "${TRT_RTX_EP_PATH}"
                        ]
                    ]
                }
            ]
        }
    },
    "data_configs": [
        {
            "name": "whisper_encoder_steady_state",
            "type": "DummyDataContainer",
            "load_dataset_config": {
                "params": {
                    "input_names": ["input_features"],
                    "input_shapes": [[1, 80, 3000]],
                    "input_types": ["float32"]
                }
            }
        }
    ],
    "passes": {
        "fp16": {
            "type": "OnnxFloatToFloat16",
            "save_as_external_data": true
        },
        "session_params": {
            "type": "OrtSessionParamsTuning",
            "io_bind": true,
            "providers_list": "NvTensorRTRTXExecutionProvider",
            "data_config": "whisper_encoder_steady_state"
        }
    },
    "evaluators": {
        "latency_evaluator": {
            "metrics": [
                {
                    "name": "latency",
                    "type": "latency",
                    "sub_types": [
                        {"name": "avg", "priority": 1, "higher_is_better": false},
                        {"name": "max"},
                        {"name": "min"}
                    ],
                    "data_config": "whisper_encoder_steady_state"
                }
            ]
        }
    },
    "target": "local_system",
    "evaluator": "latency_evaluator",
    "cache_dir": "cache",
    "output_dir": "build/whisper-tiny-onnx_encoder_trtrtx_fp16",
    "log_severity_level": 1
}
