{
    "input_model": {
        "type": "HfModel",
        "model_path": "microsoft/Phi-4-mini-instruct",
        "task": "text-generation"
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [ { "device": "cpu", "execution_providers": [ "CPUExecutionProvider" ] } ]
        }
    },
    "engine": { "target": "local_system" },
    "data_configs": [
        {
            "name": "calibration_data",
            "type": "HuggingFaceContainer",
            "load_dataset_config": {
                "path": "wikitext",
                "subset": "wikitext-2-raw-v1",
                "split": "train"
            },
            "pre_process_data_config": {
                "input_cols": [ "text" ],
                "max_length": 512,
                "padding": "max_length"
            },
            "dataloader_config": {
                "batch_size": 1
            }
        }
    ],
    "passes": {
        "builder": { "type": "ModelBuilder", "precision": "fp32" },
        "quantization": {
            "type": "OnnxStaticQuantization",
            "quant_format": "QDQ",
            "per_channel": false,
            "reduce_range": false,
            "calibrate_method": "MinMax",
            "calibration_sampling_size": 128,
            "data_config": "calibration_data"
        }
    },
    "target": "local_system",
    "log_severity_level": 1,
    "output_dir": "models/phi-4-mini-instruct-cpu-int8-static",
    "cache_dir": "cache",
    "no_artifacts": true
}
