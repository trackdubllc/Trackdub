{
    "input_model": {
        "type": "OnnxModel",
        "model_path": "${MODEL_ROOT}/encoder.onnx",
        "inference_settings": {
            "execution_provider": [
                "NvTensorRTRTXExecutionProvider"
            ],
            "provider_options": [
                {
                    "nv_profile_min_shapes": "processed_signal:1x128x65,processed_signal_length:1,cache_last_channel:24x1x56x1024,cache_last_time:24x1x1024x8,cache_last_channel_len:1,prompt_index:1",
                    "nv_profile_opt_shapes": "processed_signal:1x128x65,processed_signal_length:1,cache_last_channel:24x1x56x1024,cache_last_time:24x1x1024x8,cache_last_channel_len:1,prompt_index:1",
                    "nv_profile_max_shapes": "processed_signal:1x128x65,processed_signal_length:1,cache_last_channel:24x1x56x1024,cache_last_time:24x1x1024x8,cache_last_channel_len:1,prompt_index:1"
                }
            ]
        }
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "gpu",
                    "execution_providers": [
                        [
                            "NvTensorRTRTXExecutionProvider",
                            "${TRT_RTX_EP_PATH}"
                        ]
                    ]
                }
            ]
        }
    },
    "passes": {
        "fp16": {
            "type": "OnnxFloatToFloat16",
            "save_as_external_data": true,
            "keep_io_types": true
        }
    },
    "target": "local_system",
    "cache_dir": "cache",
    "output_dir": "build/nemotron-3.5-asr-onnx_encoder_trtrtx_fp16",
    "log_severity_level": 1
}
