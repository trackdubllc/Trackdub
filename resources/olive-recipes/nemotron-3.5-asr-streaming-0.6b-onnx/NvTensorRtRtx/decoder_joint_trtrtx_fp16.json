{
    "input_model": {
        "type": "OnnxModel",
        "model_path": "${MODEL_ROOT}/decoder_joint.onnx"
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "gpu",
                    "execution_providers": [
                        [
                            "NvTensorRTRTXExecutionProvider",
                            "${TRT_RTX_EP_PATH}"
                        ]
                    ]
                }
            ]
        }
    },
    "data_configs": [
        {
            "name": "nemotron_decoder_joint_step",
            "type": "DummyDataContainer",
            "load_dataset_config": {
                "params": {
                    "input_names": [
                        "encoder_outputs",
                        "targets",
                        "target_length",
                        "input_states_1",
                        "input_states_2"
                    ],
                    "input_shapes": [
                        [
                            1,
                            1024,
                            1
                        ],
                        [
                            1,
                            1
                        ],
                        [
                            1
                        ],
                        [
                            2,
                            1,
                            640
                        ],
                        [
                            2,
                            1,
                            640
                        ]
                    ],
                    "input_types": [
                        "float32",
                        "int64",
                        "int64",
                        "float32",
                        "float32"
                    ]
                }
            }
        }
    ],
    "passes": {
        "fp16": {
            "type": "OnnxFloatToFloat16",
            "save_as_external_data": true,
            "keep_io_types": true
        },
        "session_params": {
            "type": "OrtSessionParamsTuning",
            "io_bind": false,
            "providers_list": "NvTensorRTRTXExecutionProvider",
            "data_config": "nemotron_decoder_joint_step"
        }
    },
    "evaluators": {
        "latency_evaluator": {
            "metrics": [
                {
                    "name": "latency",
                    "type": "latency",
                    "sub_types": [
                        {
                            "name": "avg",
                            "priority": 1,
                            "higher_is_better": false
                        },
                        {
                            "name": "max"
                        },
                        {
                            "name": "min"
                        }
                    ],
                    "data_config": "nemotron_decoder_joint_step"
                }
            ]
        }
    },
    "target": "local_system",
    "evaluator": "latency_evaluator",
    "cache_dir": "cache",
    "output_dir": "build/nemotron-3.5-asr-onnx_decoder_joint_trtrtx_fp16",
    "log_severity_level": 1
}
