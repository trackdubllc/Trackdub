{
    "input_model": {
        "type": "OnnxModel",
        "model_path": "${MODEL_ROOT}/decoder_joint.onnx"
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "gpu",
                    "execution_providers": [
                        "NvTensorRTRTXExecutionProvider"
                    ]
                }
            ]
        }
    },
    "passes": {
        "mxfp8_quantization": {
            "type": "NVModelOptQuantization",
            "precision": "mxfp8",
            "calibration_method": "max",
            "calibrate_per_node": true,
            "calibration_providers": [
                "NvTensorRTRTXExecutionProvider"
            ]
        },
        "session_params": {
            "type": "OrtSessionParamsTuning",
            "io_bind": false,
            "execution_provider": "NvTensorRTRTXExecutionProvider"
        }
    },
    "evaluators": {
        "latency_evaluator": {
            "metrics": [
                {
                    "name": "latency",
                    "type": "latency",
                    "sub_types": [
                        {
                            "name": "avg",
                            "priority": 1,
                            "higher_is_better": false
                        },
                        {
                            "name": "max"
                        },
                        {
                            "name": "min"
                        }
                    ]
                }
            ]
        }
    },
    "target": "local_system",
    "evaluator": "latency_evaluator",
    "cache_dir": "cache",
    "output_dir": "build/nemotron-3.5-asr-onnx_decoder_joint_trtrtx_mxfp8",
    "log_severity_level": 1
}
