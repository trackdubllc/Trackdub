{
    "input_model": {
        "type": "OnnxModel",
        "model_path": "${MODEL_ROOT}/onnx/encoder_model.onnx"
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "gpu",
                    "execution_providers": [
                        "NvTensorRTRTXExecutionProvider"
                    ]
                }
            ]
        }
    },
    "passes": {
        "fp16": {
            "type": "OnnxFloatToFloat16",
            "save_as_external_data": true
        },
        "session_params": {
            "type": "OrtSessionParamsTuning",
            "io_bind": true,
            "execution_provider": "NvTensorRTRTXExecutionProvider"
        }
    },
    "evaluators": {
        "latency_evaluator": {
            "metrics": [
                {
                    "name": "latency",
                    "type": "latency",
                    "sub_types": [
                        {"name": "avg", "priority": 1, "higher_is_better": false},
                        {"name": "max"},
                        {"name": "min"}
                    ]
                }
            ]
        }
    },
    "target": "local_system",
    "evaluator": "latency_evaluator",
    "cache_dir": "cache",
    "output_dir": "build/whisper-large-v3-onnx_encoder_trtrtx_fp16",
    "log_severity_level": 1
}
