<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      nuget.org is the primary source for all packages.

      dotnet-libraries is a public Azure Artifacts feed that provides nightly builds
      of dotnet/* packages. It is required because Microsoft.ML.Tokenizers 3.x
      (which introduces SentencePieceTokenizer) has not yet shipped as a stable
      NuGet.org release. Once a stable 3.x appears on nuget.org, remove this feed
      and update Directory.Packages.props to pin the stable version.

      Feed: https://github.com/dotnet/machinelearning
    -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="dotnet-libraries" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-libraries/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSourceMapping>
    <!--
      All packages resolve from nuget.org unless explicitly mapped here.
      Microsoft.ML.Tokenizers resolves from dotnet-libraries because its 3.x
      preview builds are not published to nuget.org. Stable Microsoft.ML.*
      packages such as OnnxRuntime still resolve from nuget.org.
    -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-libraries">
      <package pattern="Microsoft.ML.Tokenizers" />
    </packageSource>
  </packageSourceMapping>
</configuration>
